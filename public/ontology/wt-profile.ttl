@prefix wt: <https://w3id.org/sdt-wt/demo#> .
@prefix sdt: <http://purl.org/sdt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

wt: a owl:Ontology ; owl:versionInfo "1.1" ; rdfs:comment "WT simulation application extension. Local vocabulary identifier; registration is not claimed. Original SDT ontology is unchanged. Version 1.1 adds bounded captured-question evidence, cost items and retained event summaries; no physical actuation or authorisation is asserted." .
wt:PseudoRULEstimate a owl:Class ; rdfs:seeAlso sdt:RULEstimate ; rdfs:comment "Synthetic model-hour estimate. Not a subclass or equivalent of the physical-hours SDT estimate." .
wt:PseudoHour rdfs:label "Synthetic model-hour" .
wt:GBP rdfs:label "Assumed GBP cost" .
wt:FeatureWindow a owl:Class .
wt:Feature a owl:Class .
wt:Candidate a owl:Class .
wt:Snapshot a owl:Class .
wt:ModelArtifact a owl:Class .
wt:CostItem a owl:Class .
wt:Millimetre rdfs:label "Millimetre" .
wt:MetrePerSecond rdfs:label "Metre per second" .
wt:Degree rdfs:label "Direction in degrees" .
wt:StandardGravity rdfs:label "Acceleration RMS in g" .
wt:ModeledHour rdfs:label "Compressed modeled downtime hour; not wall-clock elapsed time" .
