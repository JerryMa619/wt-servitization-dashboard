# --- Equipment module ---

sdt:hasComponent
    a owl:ObjectProperty ;
    rdfs:label "hasComponent"@en ;
    rdfs:comment "Asset decomposition hierarchy — links an Asset to its Components."@en ;
    rdfs:domain sdt:Asset ;
    rdfs:range sdt:Component .

sdt:hasSubComponent
    a owl:ObjectProperty ;
    rdfs:label "hasSubComponent"@en ;
