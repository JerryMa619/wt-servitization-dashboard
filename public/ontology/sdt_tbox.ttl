    rdfs:domain sdt:Asset ;
    rdfs:range sdt:OperatingSite .

sdt:exposedTo
    a owl:ObjectProperty ;
    rdfs:label "exposedTo"@en ;
    rdfs:comment "Environmental conditions affecting the asset — links an Asset to OperatingEnvironment."@en ;
    rdfs:domain sdt:Asset ;
    rdfs:range sdt:OperatingEnvironment .

